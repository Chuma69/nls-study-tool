# ─────────────────────────────────────────────────────────────
# NLS Study Tool — environment variables
# Copy to .env.local (app) and ingestion/.env (pipeline) as needed.
# NEVER commit real values.
# ─────────────────────────────────────────────────────────────

# Anthropic Claude API key (tutor answers, MCQ explanations, ingestion extraction)
ANTHROPIC_API_KEY=

# Neon Postgres connection string.
# In production this is injected automatically by the Vercel <-> Neon Marketplace
# integration. For local dev / ingestion, paste the pooled connection string from
# the Neon dashboard.
DATABASE_URL=

# Only needed if the SQLite knowledge-base index is served from Vercel Blob
# (i.e. it exceeds the ~50 MB bundle threshold). Left blank when bundled.
BLOB_READ_WRITE_TOKEN=

# Secret used to sign/hash the passwordless session token. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# LLM cost controls (PRD v3 §2). Daily caps; UI shows a "budget reached" state.
LLM_DAILY_GLOBAL_LIMIT=
LLM_DAILY_SESSION_LIMIT=

# Comma-separated admin emails allowed to see the corpus/status admin view.
ADMIN_EMAIL_ALLOWLIST=
