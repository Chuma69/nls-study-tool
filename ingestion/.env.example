# Ingestion pipeline env (local only). Copy to ingestion/.env
DATABASE_URL=            # Neon pooled connection string from the Neon dashboard
OPENAI_API_KEY=          # local-only key for MCQ/theory extraction

# Optional model overrides (defaults set in nls_ingest/config.py).
# Verify current IDs at https://developers.openai.com/api/docs/models
# MODEL_EXTRACTION=
# MODEL_REASONING=

# Current GPT-4o mini list prices used in the dry-run estimate (USD / million tokens).
# Override only after verifying OpenAI pricing.
# EXTRACTION_INPUT_USD_PER_MTOK=0.15
# EXTRACTION_OUTPUT_USD_PER_MTOK=0.60
# QUESTION_EXTRACTION_MAX_INPUT_TOKENS=30000
# QUESTION_EXTRACTION_MAX_OUTPUT_TOKENS=16000
